<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.vhrabar.issuehub</id>
    <name>IssueHub</name>
    <vendor url="https://github.com/vhrabar">Vedran Hrabar</vendor>
    <!-- <description> is injected at build time from README.md -->

    <depends>com.intellij.modules.platform</depends>

    <!-- Only to borrow accounts the user has already signed in with; IssueHub works without it. -->
    <depends optional="true" config-file="issuehub-withGitHubPlugin.xml">org.jetbrains.plugins.github</depends>

    <resource-bundle>messages.IssueHubBundle</resource-bundle>

    <extensionPoints>
        <extensionPoint
            name="issueProvider"
            interface="com.github.vhrabar.issuehub.provider.IssueProvider"
            dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="IssueHub"
            anchor="left"
            icon="/icons/issueHub.svg"
            factoryClass="com.github.vhrabar.issuehub.toolWindow.IssueHubToolWindowFactory"/>

        <!-- Issues open in the editor area, not as tool window tabs. -->
        <fileEditorProvider implementation="com.github.vhrabar.issuehub.editor.IssueFileEditorProvider"/>
        <fileIconProvider implementation="com.github.vhrabar.issuehub.editor.IssueFileIconProvider"/>

        <applicationConfigurable
            parentId="tools"
            id="com.github.vhrabar.issuehub.settings"
            key="settings.displayName"
            instance="com.github.vhrabar.issuehub.settings.IssueHubConfigurable"/>
    </extensions>

    <extensions defaultExtensionNs="com.github.vhrabar.issuehub">
        <issueProvider implementation="com.github.vhrabar.issuehub.provider.github.GitHubIssueProvider"/>
    </extensions>
</idea-plugin>