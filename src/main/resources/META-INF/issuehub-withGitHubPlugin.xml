<!--
  Loaded only when the IDE's GitHub plugin is installed. Registering the account importer here is
  what gives us access to that plugin's account classes, and what keeps them from being loaded at
  all when it is absent: no importer is contributed, so nothing naming it is ever touched.
-->
<idea-plugin>
    <extensions defaultExtensionNs="com.github.vhrabar.issuehub">
        <ideAccountImporter implementation="com.github.vhrabar.issuehub.provider.github.IdeGitHubAccounts"/>
    </extensions>
</idea-plugin>
